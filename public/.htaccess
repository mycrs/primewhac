# APACHE / OpenLiteSpeed - Production Final Config
DirectoryIndex index.html

AddType image/svg+xml .svg
AddType application/xml .xml
AddType text/plain .txt

# HTTP Content-Type header'ına charset=UTF-8 ekle (SEO: "Missing charset" uyarısı)
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .htm .css .js .json .xml .svg .txt

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ------------------------------------------------------------
  # 1. GERÇEK DOSYA VE DİZİNLER: Doğrudan servis et, rewrite yapma!
  # (CSS, JS, resimler ve prerender edilmiş dizinler doğrudan açılır)
  # ------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # ------------------------------------------------------------
  # 2. STATİK DOSYA UZANTILARI: index.html veya slash kuralına ASLA girmez
  # ------------------------------------------------------------
  RewriteRule \.(svg|xml|txt|ico|png|jpg|jpeg|gif|webp|json|css|js|woff2?|ttf|eot|mp4|webm)$ - [L]

  # ------------------------------------------------------------
  # 3. ŞÜPHELİ REFERER ENGELLEME (adult / kumar / bahis / spam ağları)
  # ------------------------------------------------------------
  RewriteCond %{HTTP_REFERER} !^$
  RewriteCond %{HTTP_REFERER} (porn|xxx|\bsex\b|sexy|sexcam|sexchat|sexshop|adult|escort|hentai|camgirl|webcam|milf|nude|erotik|erotic|fetish|bdsm|onlyfans|viagra|cialis)     [NC,OR]
  RewriteCond %{HTTP_REFERER} (casino|gambl|poker|\bslots?\b|bahis|iddaa|\bbet\b|bet365|betway|betfair|betting|rulet|roulette|blackjack)                                        [NC,OR]
  RewriteCond %{HTTP_REFERER} (\bdating\b|hookup|sugardaddy|adultfriend|\bmilf\b)                                                                                              [NC,OR]
  RewriteCond %{HTTP_REFERER} (^https?://([^/]+\.)?l\.wl\.co)                                                                                                                  [NC]
  RewriteRule ^ - [F,L]

  # ------------------------------------------------------------
  # 4. HTTP -> HTTPS + WWW -> NON-WWW (Tek kural, tek hop)
  # ------------------------------------------------------------
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://cineverse.pro/$1 [R=301,L]

  # ------------------------------------------------------------
  # 5. KANONİK URL: index.html KALDIRMA (Yalnızca dış istemci istekleri)
  # %{ENV:REDIRECT_STATUS} ^$ döngüyü (loop) %100 engeller.
  # ------------------------------------------------------------
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^index\.html$ / [R=301,L]

  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^(.*)/index\.html$ /$1/ [R=301,L]

  # ------------------------------------------------------------
  # 6. DİL & YÖNLENDİRME KURALLARI (301 REDIRECTS)
  # ------------------------------------------------------------
  # Dil kökü de slash'lı canonical: /de -> /de/
  RewriteRule ^de$ /de/ [R=301,L]

  RewriteRule ^packages/?$                /paketler/      [R=301,L]
  RewriteRule ^about/?$                   /hakkimizda/    [R=301,L]
  RewriteRule ^installation/?$            /kurulum/       [R=301,L]
  RewriteRule ^installation/(.+)$         /kurulum/$1     [R=301,L,QSA]
  RewriteRule ^instructions/?$            /kurulum/       [R=301,L]
  RewriteRule ^instructions/(.+)$         /kurulum/$1     [R=301,L,QSA]
  RewriteRule ^faq/?$                     /sss/           [R=301,L]
  RewriteRule ^bayilik/?$                 /reseller/      [R=301,L]
  RewriteRule ^privacy/?$                 /gizlilik/      [R=301,L]
  RewriteRule ^terms/?$                   /sartlar/       [R=301,L]
  RewriteRule ^what-to-watch/?$           /ne-izlesem/    [R=301,L]
  RewriteRule ^what-to-watch/(.+)$        /ne-izlesem/$1  [R=301,L,QSA]
  RewriteRule ^ne-izlesem/netflix-dizileri/?$                    /ne-izlesem/populer-yabanci-diziler/                    [R=301,L]
  RewriteRule ^de/was-soll-ich-schauen/netflix-serien/?$         /de/was-soll-ich-schauen/beliebte-auslaendische-serien/ [R=301,L]
  RewriteRule ^kanallar/?$                /channels/      [R=301,L]
  RewriteRule ^de/packages/?$             /de/pakete/     [R=301,L]
  RewriteRule ^de/paketler/?$             /de/pakete/     [R=301,L]
  RewriteRule ^de/kurulum/?$              /de/einrichtung/ [R=301,L]
  RewriteRule ^de/kurulum/(.+)$           /de/einrichtung/$1 [R=301,L,QSA]
  RewriteRule ^de/sueper-lig-in-deutschland/?$            /de/kanale/     [R=301,L]
  RewriteRule ^de/bein-sports-tuerkiye-in-deutschland/?$  /de/kanale/     [R=301,L]
  RewriteRule ^blog/galatasaray-liverpool-maci/?$                                   /blog/ [R=301,L]
  RewriteRule ^blog/galatasaray-liverpool-maci-nereden-izlenir-.*$                  /blog/ [R=301,L]
  RewriteRule ^blog/galatasaray-trabzonspor-galatasaray-maci-.*$                    /blog/ [R=301,L]
  RewriteRule ^blog/galatasaray-fenerbahce-derbisi-.*$                              /blog/ [R=301,L]
  RewriteRule ^blog/besiktas-galatasaray-derbisi-.*$                                /blog/ [R=301,L]
  RewriteRule ^blog/juventus-galatasaray-mac-ozeti-.*$                              /blog/ [R=301,L]
  RewriteRule ^blog/galatasaray-tarihe-kosuyor/?$                                   /blog/ [R=301,L]
  RewriteRule ^blog/derbiyi-donmadan-izle/?$                                        /blog/ [R=301,L]
  RewriteRule ^blog/sampiyonlar-ligi-son-16/?$                                      /blog/ [R=301,L]
  RewriteRule ^blog/sampiyonlar-ligi-ceyrek-final-.*$                               /blog/ [R=301,L]
  RewriteRule ^blog/2026-dunya-kupasi-maclari-nereden-izlenir/?$                     /blog/ [R=301,L]
  RewriteRule ^mac-programi/[a-z0-9-]+$   /mac-programi/  [R=301,L]
  RewriteRule ^de/spielplan/[a-z0-9-]+$   /de/spielplan/  [R=301,L]
  RewriteRule ^spor-gundemi(/.*)?$        /mac-programi/  [R=301,L]
  RewriteRule ^kurulum/windows-next-plus/?$              /kurulum/windows-ibo-player/              [R=301,L]
  RewriteRule ^kurulum/windows-castora/?$                /kurulum/windows-vs-player/               [R=301,L]
  RewriteRule ^de/einrichtung/windows-next-plus/?$       /de/einrichtung/windows-ibo-player/       [R=301,L]
  RewriteRule ^de/einrichtung/windows-castora/?$         /de/einrichtung/windows-vs-player/        [R=301,L]
  RewriteRule ^karsilastir/?$             /karsilastirma/               [R=301,L]
  RewriteRule ^detayli-kurulum/?$         /detailed-guides/             [R=301,L]
  RewriteRule ^detailed-instructions/?$   /detailed-guides/             [R=301,L]
  RewriteRule ^test-yayini/?$             /test/                        [R=301,L]
  RewriteRule ^guide/?$                   /guide/iptv-kurulum-rehberi/  [R=301,L]
  RewriteRule ^titan-iptv-satin-al/?$     /titan-iptv/                  [R=301,L]
  RewriteRule ^de/iptv/?$                 /de/pakete/                   [R=301,L]
  RewriteRule ^de/karsilastir/?$          /de/vergleich/                [R=301,L]
  RewriteRule ^de/detayli-kurulum/?$      /de/detaillierte-anleitungen/ [R=301,L]
  RewriteRule ^de/setup/?$                /de/einrichtung/              [R=301,L]
  RewriteRule ^de/setup/(.+)$             /de/einrichtung/$1            [R=301,L,QSA]
  RewriteRule ^de/kontakt/?$              /de/pakete/                   [R=301,L]
  RewriteRule ^de/faq/?$                  /de/sss/                      [R=301,L]
  RewriteRule ^blog/-derbi-gn-iptv-donmamas-iin-bilmeniz-gereken-her-ey/?$    /blog/derbi-gunu-iptv-donmamasi-icin-bilmeniz-gereken-her-sey/    [R=301,L]
  RewriteRule ^de/blog/-derbi-gn-iptv-donmamas-iin-bilmeniz-gereken-her-ey/?$ /de/blog/derbi-gunu-iptv-donmamasi-icin-bilmeniz-gereken-her-sey/ [R=301,L]

  # ------------------------------------------------------------
  # 7. TRAILING SLASH: Yalnızca uzantısız sayfa yolları için (/paketler -> /paketler/)
  # ------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*[^/])$ /$1/ [L,R=301]

  # ------------------------------------------------------------
  # 8. SPA WHITELIST: Client-side rotalar /index.html'e yönlenir
  # ------------------------------------------------------------
  RewriteRule ^(yonetim|admin|admin-login|musteri-kayit|bing-verification)(/.*)?$ /index.html [L]
  RewriteRule ^blog/write(/.*)?$ /index.html [L]

  # ------------------------------------------------------------
  # 9. PRERENDER DİZİNLERİ: Mevcut dizinin index.html'i servis edilir
  # ------------------------------------------------------------
  RewriteRule ^de/$ /de/index.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  RewriteRule ^$ index.html [L]

  # ------------------------------------------------------------
  # 10. SOFT-404 KAPALI: Karşılığı olmayan istekler gerçek 404 döner
  # ------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . - [R=404,L]
</IfModule>

# Gerçek 404 sayfası
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|svg|png|jpg|jpeg|gif|webp|ico|woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header append Vary Accept-Encoding
  </FilesMatch>
  # sw.js yukarıdaki .js kuralına girer; uzun cache yeni sürümün yansımamasına yol açar
  <Files "sw.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header unset ETag
  </Files>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "fixtures.*\.json$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # Security headers
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://api.themoviedb.org https://*.supabase.co wss://*.supabase.co https://qruzetv.com https://cineverse.pro https://www.cineverse.pro https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com https://www.youtube.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Serve pre-compressed Brotli/Gzip assets if available
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP:Accept-Encoding} br
  RewriteCond %{REQUEST_FILENAME}.br -f
  RewriteRule ^(.+)\.(js|css|html|svg|json)$ $1.$2.br [L]

  RewriteCond %{HTTP:Accept-Encoding} gzip
  RewriteCond %{REQUEST_FILENAME}.gz -f
  RewriteRule ^(.+)\.(js|css|html|svg|json)$ $1.$2.gz [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.js\.br$">
    ForceType application/javascript
    Header set Content-Encoding br
    Header append Vary Accept-Encoding
  </FilesMatch>
  <FilesMatch "\.css\.br$">
    ForceType text/css
    Header set Content-Encoding br
    Header append Vary Accept-Encoding
  </FilesMatch>
  <FilesMatch "\.json\.br$">
    ForceType application/json
    Header set Content-Encoding br
    Header append Vary Accept-Encoding
  </FilesMatch>
  <FilesMatch "\.js\.gz$">
    ForceType application/javascript
    Header set Content-Encoding gzip
    Header append Vary Accept-Encoding
  </FilesMatch>
  <FilesMatch "\.css\.gz$">
    ForceType text/css
    Header set Content-Encoding gzip
    Header append Vary Accept-Encoding
  </FilesMatch>
  <FilesMatch "\.json\.gz$">
    ForceType application/json
    Header set Content-Encoding gzip
    Header append Vary Accept-Encoding
  </FilesMatch>
</IfModule>
