{
  "name": "vite-react-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host :: --port 3000 --strictPort",
    "dev:api": "cross-env NODE_ENV=development PORT=3001 node server/index.js",
    "dev:all": "concurrently -n api,vite -c blue,green \"npm run dev:api\" \"npm run dev\"",
    "build": "node scripts/build.js",
    "build:prerender": "node scripts/sync-seo-routes.mjs && vite build",
    "lint": "eslint . --quiet",
    "preview": "vite preview --host :: --port 3000",
    "start": "node server/index.js",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "blog:generate": "node scripts/generate-blog-posts.mjs",
    "blog:generate:sport": "node scripts/generate-blog-posts.mjs --category \"Spor Gündemi\"",
    "blog:generate:tech": "node scripts/generate-blog-posts.mjs --category \"Teknoloji Gündemi\"",
    "generate:og": "node scripts/generate-og-images.js",
    "sync:seo-routes": "node scripts/sync-seo-routes.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "check:env": "node scripts/check-env.mjs",
    "smoke:api": "node scripts/smoke-api.mjs",
    "smoke:all": "npm run check:env && npm run smoke:api",
    "deploy": "node scripts/deploy.js",
    "deploy:build": "node scripts/deploy.js --build",
    "deploy:dry": "node scripts/deploy.js --dry"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@google/genai": "^1.43.0",
    "@hcaptcha/react-hcaptcha": "^2.0.2",
    "@marsidev/react-turnstile": "^1.5.0",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@supabase/supabase-js": "2.30.0",
    "axios": "^1.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.2.1",
    "framer-motion": "^10.16.4",
    "lucide-react": "^0.292.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet": "^6.1.0",
    "react-helmet-async": "^2.0.4",
    "react-router-dom": "^6.16.0",
    "react-syntax-highlighter": "^16.1.0",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "^3.5.0"
  },
  "devDependencies": {
    "@prerenderer/renderer-puppeteer": "^1.2.4",
    "@prerenderer/rollup-plugin": "^0.3.12",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "ftp-deploy": "^2.4.7",
    "globals": "^15.14.0",
    "postcss": "^8.4.32",
    "puppeteer": "^24.37.5",
    "serve": "^14.2.5",
    "tailwindcss": "^3.3.6",
    "vite": "^5.0.8"
  }
}
