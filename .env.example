# Opsiyonel: tam logo URL; boşsa /logo.png (public) kullanılır
# VITE_BRAND_LOGO_URL=https://example.com/custom-logo.png

# Canlı site kökü (canonical, schema, sitemap). Örn: https://cineverse.pro
VITE_SITE_URL=https://cineverse.pro

# Staging build: true = production build’de robots.txt tam Disallow (/). Canlı yayında false bırakın.
VITE_TEST_MODE=false

# --- Supabase (giriş / veritabanı için zorunlu) ---
# Dashboard: https://supabase.com → Projen → Settings → API
# Project URL → VITE_SUPABASE_URL (sonunda / olmasın, tırnak kullanmayın)
# anon public → VITE_SUPABASE_ANON_KEY (eyJhbGci... ile başlayan tam JWT, 3 parça)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PASTE_FULL_ANON_KEY_HERE
# Express API (npm run dev:api / dev:all): aynı Supabase projesi — müşteri listesi/detayı uyumsuzsa 404 görürsünüz
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=(VITE ile aynı anon key)
# SUPABASE_SERVICE_ROLE_KEY=(Settings → API → service_role — sunucuda kalır, istemciye koymayın)
# API_PORT=3001
# GEMINI_API_KEY=(maç içeriği AI — isteğe bağlı; /api/health/gemini)
# Maç içeriği (build/pregenerate): varsayılan yalnızca public/data JSON — kota için Supabase okuma/yazma kapalı.
# İsterseniz üretilen içeriği match_contents tablosuna da yazmak için: SUPABASE_SYNC_MATCH_CONTENT=1
# SUPABASE_SYNC_MATCH_CONTENT=
# WhatsApp destek numarasını .env dosyasına yazmayın.
# Numara yalnızca admin panel > İletişim Bilgileri üzerinden Supabase'e girilir
# ve form gönderimi sırasında runtime'da kullanılır.

# Cloudflare Turnstile — yönetici girişi (/yonetim/giris) + müşteri portalı sorgusu
# Dashboard: https://dash.cloudflare.com → Turnstile
# Production Vite build: gerçek site key. Geliştirmede (npm run dev) istemci ve API otomatik test anahtarı kullanır.
VITE_TURNSTILE_SITE_KEY=
# Sunucu (.env / Node API): production’da zorunlu — asla Vite bundle’a koymayın
TURNSTILE_SECRET_KEY=

# Müşteri portalı — isteğe bağlı hCaptcha (Turnstile ile birlikte kullanılmaz; biri yeterli; hCaptcha önceliklidir)
# VITE_HCAPTCHA_SITE_KEY=
# HCAPTCHA_SECRET=

# API yoksa token ile gevşetme (daha zayıf): true
# VITE_PORTAL_CAPTCHA_RELAXED=true

# TMDB API Configuration (Required)
# Get your key at https://www.themoviedb.org/settings/api
# SECURITY NOTE: Never commit real keys to git!
VITE_TMDB_API_KEY=your_tmdb_api_key_here
VITE_TMDB_BEARER_TOKEN=your_tmdb_bearer_token_here

# --- FTP Deploy (npm run deploy) ---
# Hostinger hPanel → Dosyalar → FTP Hesapları bölümünden alın.
# Bu değişkenler yalnızca yerelde kullanılır (dist/ → sunucu). Git'e commit ETMEYIN.
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_REMOTE_DIR=/public_html
FTP_PORT=21
# Explicit FTPS (TLS) için: true. Hostinger çoğunlukla plain FTP kullanır → boş bırakın.
# FTP_SECURE=false
# Ek hariç tutmalar (virgüllü, glob): örn. "*.map,tmp/**"
# FTP_EXCLUDE=
